# FlexNet License Server - Environment Configuration
#
# FLEXNET_PACKAGE_URL accepts either:
#   - a public HTTPS URL to the vendor FlexNet package (tar.gz with RPMs, or zip)
#   - a local file reference "packages/<filename>" for packages that are only
#     available behind a vendor login (e.g. Xilinx/AMD FlexLM). Place the file
#     in ./packages/ before building.

# --- Vendor FlexNet package -------------------------------------------------
# Default: Autodesk NLM (public download, also used by CI).
FLEXNET_PACKAGE_URL=https://damassets.autodesk.net/content/dam/autodesk/www/files/linux/nlm11.19.9.0_ipv4_ipv6_linux64.tar.gz
# Xilinx/AMD FlexLM (local file in ./packages/, requires a vendor login):
#FLEXNET_PACKAGE_URL=packages/linux_flexlm__v11.17.2.0.zip

# --- License server identity (must match the license file) ------------------
FLEXNET_HOSTNAME=name_of_server
FLEXNET_MAC_ADDRESS=XX:XX:XX:XX:XX:XX

# --- Runtime ----------------------------------------------------------------
FLEXNET_IMAGE=flexnetserver:local
FLEXNET_PLATFORM=linux/amd64
FLEXNET_PORT=2100
# Must match "VENDOR <name> PORT=" in the license file (27010 = Xilinx default suggestion)
FLEXNET_VENDOR_PORT=27010
FLEXNET_COMMAND=-z

# (lmgrd) usage: lmgrd [-l [+]debug_log_path] [-2 -p] [-z] [-c license_file_list]
# (lmgrd)              [-datestamp]
# (lmgrd)              [-v] [-local]
# (lmgrd)              [-localonly]
# (lmgrd)              [-x lmdown|lmremove] [-help]
# (lmgrd)              [-servTransferred]
# (lmgrd) Use -l option before other options to log all debugging information to debug_log_path.
